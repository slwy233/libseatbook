{
  "expo": {
    "name": "天商书座",
    "slug": "seat-booker",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon_v1_blue.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon_v1_blue.png",
      "backgroundColor": "#1677FF",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seatbooker.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_v1_blue.png",
        "backgroundColor": "#1677FF"
      },
      "package": "com.seatbooker.app",
      "versionCode": 6,
      "permissions": [
        "INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-asset",
      "./plugins/withAndroidNetwork"
    ],
    "extra": {
      "eas": {
        "projectId": "a5fe7e56-7f3e-4484-9fc1-229339013e36"
      }
    },
    "owner": "wuti"
  }
}
