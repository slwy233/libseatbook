{
  "name": "seat-booker",
  "version": "1.0.1",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --test tests/*.test.cjs",
    "check:source": "node scripts/check-source.cjs",
    "export:web": "expo export --platform web --output-dir outputs/web",
    "export:android": "expo export --platform android --output-dir outputs/android-bundle",
    "demo:prepare": "node scripts/create-demo.cjs",
    "demo:serve": "python -m http.server 8788 --bind 127.0.0.1 --directory outputs/demo",
    "check:android": "node scripts/check-android-config.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "crypto-js": "^4.2.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-dev-client": "~5.0.20",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "react-test-renderer": "^18.3.1"
  },
  "private": true
}
